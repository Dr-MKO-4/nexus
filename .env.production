# ============================================================
# NEXUS AI  Template de configuration production
# NE PAS committer ce fichier une fois rempli avec de vraies valeurs.
# Toutes les valeurs ci-dessous sont des placeholders à remplacer
# via le gestionnaire de secrets de l'infrastructure (Vault, AWS
# Secrets Manager, variables d'environnement CI/CD, etc.).
# ============================================================

# --- LLM : arbitrage hybride entre inférence locale (GPU dédiés) et API ---
LLM_MODE=hybrid
LOCAL_INFERENCE_ENGINE=vllm
LOCAL_DEFAULT_MODEL=llama3.3:70b
LOCAL_FAST_MODEL=mistral:7b
VLLM_BASE_URL=<VLLM_BASE_URL>
OLLAMA_BASE_URL=<OLLAMA_BASE_URL>

API_PRIMARY_PROVIDER=groq
API_FALLBACK_PROVIDER=together
API_DEFAULT_MODEL=<API_DEFAULT_MODEL>
API_FAST_MODEL=<API_FAST_MODEL>

HYBRID_COST_DAILY_LIMIT_USD=50.0
HYBRID_GPU_LOAD_THRESHOLD=0.8
HYBRID_SENSITIVE_TASKS=["client_pii","financial_data"]

# --- Base de données & stockage : instances managées ---
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>
REDIS_URL=redis://<REDIS_HOST>:6379/0
QDRANT_HOST=<QDRANT_HOST>
QDRANT_PORT=6333
PYTORCH_MODELS_URL=<PYTORCH_MODELS_URL>
SEARXNG_BASE_URL=<SEARXNG_BASE_URL>
N8N_BASE_URL=<N8N_BASE_URL>
N8N_API_KEY=<N8N_API_KEY>
MAUTIC_BASE_URL=<MAUTIC_BASE_URL>
MAUTIC_CLIENT_ID=<MAUTIC_CLIENT_ID>
MAUTIC_CLIENT_SECRET=<MAUTIC_CLIENT_SECRET>
MATOMO_BASE_URL=<MATOMO_BASE_URL>
MATOMO_API_TOKEN=<MATOMO_API_TOKEN>

# --- Observabilité ---
LANGFUSE_PUBLIC_KEY=<LANGFUSE_PUBLIC_KEY>
LANGFUSE_SECRET_KEY=<LANGFUSE_SECRET_KEY>
LANGFUSE_HOST=<LANGFUSE_HOST>

# --- Clés API des fournisseurs LLM ---
GROQ_API_KEY=<GROQ_API_KEY>
TOGETHER_API_KEY=<TOGETHER_API_KEY>
MISTRAL_API_KEY=<MISTRAL_API_KEY>
FIREWORKS_API_KEY=<FIREWORKS_API_KEY>

# --- Intégrations marketing tierces ---
GOOGLE_ADS_DEVELOPER_TOKEN=<GOOGLE_ADS_DEVELOPER_TOKEN>
GOOGLE_ADS_CLIENT_ID=<GOOGLE_ADS_CLIENT_ID>
GOOGLE_ADS_CLIENT_SECRET=<GOOGLE_ADS_CLIENT_SECRET>
META_APP_ID=<META_APP_ID>
META_APP_SECRET=<META_APP_SECRET>
FIGMA_ACCESS_TOKEN=<FIGMA_ACCESS_TOKEN>
COMFYUI_BASE_URL=<COMFYUI_BASE_URL>
COMFYUI_LORA_DIR=<COMFYUI_LORA_DIR>
SERPER_API_KEY=<SERPER_API_KEY>

# --- Sécurité & environnement ---
SECRET_KEY=<SECRET_KEY_GENERATED_RANDOMLY>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
DEBUG=False
ENVIRONMENT=production
CORS_ALLOWED_ORIGINS=["https://<FRONTEND_DOMAIN>"]

# --- Celery ---
CELERY_BROKER_URL=redis://<REDIS_HOST>:6379/1
CELERY_RESULT_BACKEND=redis://<REDIS_HOST>:6379/2

# --- AWS : stockage des assets créatifs ---
AWS_ACCESS_KEY_ID=<AWS_ACCESS_KEY_ID>
AWS_SECRET_ACCESS_KEY=<AWS_SECRET_ACCESS_KEY>
AWS_REGION=<AWS_REGION>
AWS_S3_BUCKET=<AWS_S3_BUCKET>

# --- Infrastructure Docker (services tiers) ---
POSTGRES_USER=<POSTGRES_USER>
POSTGRES_PASSWORD=<POSTGRES_PASSWORD>
POSTGRES_DB=<POSTGRES_DB>

MATOMO_DB_ROOT_PASSWORD=<MATOMO_DB_ROOT_PASSWORD>
MATOMO_DB_NAME=<MATOMO_DB_NAME>
MATOMO_DB_USER=<MATOMO_DB_USER>
MATOMO_DB_PASSWORD=<MATOMO_DB_PASSWORD>

MAUTIC_DB_ROOT_PASSWORD=<MAUTIC_DB_ROOT_PASSWORD>
MAUTIC_DB_NAME=<MAUTIC_DB_NAME>
MAUTIC_DB_USER=<MAUTIC_DB_USER>
MAUTIC_DB_PASSWORD=<MAUTIC_DB_PASSWORD>

N8N_ENCRYPTION_KEY=<N8N_ENCRYPTION_KEY>
N8N_BASIC_AUTH_USER=<N8N_BASIC_AUTH_USER>
N8N_BASIC_AUTH_PASSWORD=<N8N_BASIC_AUTH_PASSWORD>

GRAFANA_ADMIN_USER=<GRAFANA_ADMIN_USER>
GRAFANA_ADMIN_PASSWORD=<GRAFANA_ADMIN_PASSWORD>

LANGFUSE_DATABASE_URL=<LANGFUSE_DATABASE_URL>
LANGFUSE_NEXTAUTH_SECRET=<LANGFUSE_NEXTAUTH_SECRET>
LANGFUSE_SALT=<LANGFUSE_SALT>
