# ============================================================
# NEXUS AI  Environnement de développement
# Toutes les dépendances tournent en local (docker-compose).
# ============================================================

# --- LLM : tout en local, aucun coût API ---
LLM_MODE=local
LOCAL_INFERENCE_ENGINE=ollama
LOCAL_DEFAULT_MODEL=llama3.3:70b
LOCAL_FAST_MODEL=mistral:7b
VLLM_BASE_URL=http://localhost:8080
OLLAMA_BASE_URL=http://localhost:11434

# Renseignés même en mode local pour permettre de tester le fallback hybride
API_PRIMARY_PROVIDER=groq
API_FALLBACK_PROVIDER=together
API_DEFAULT_MODEL=llama-3.3-70b-versatile
API_FAST_MODEL=llama-3.1-8b-instant

HYBRID_COST_DAILY_LIMIT_USD=5.0
HYBRID_GPU_LOAD_THRESHOLD=0.9
HYBRID_SENSITIVE_TASKS=["client_pii","financial_data"]

# --- Base de données & stockage : services docker-compose locaux ---
DATABASE_URL=postgresql://nexus:nexus@localhost:5432/nexus_dev
REDIS_URL=redis://localhost:6379/0
QDRANT_HOST=localhost
QDRANT_PORT=6333
PYTORCH_MODELS_URL=http://localhost:8001
SEARXNG_BASE_URL=http://localhost:8083
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=
MAUTIC_BASE_URL=http://localhost:8082
MAUTIC_CLIENT_ID=
MAUTIC_CLIENT_SECRET=
MATOMO_BASE_URL=http://localhost:8081
MATOMO_API_TOKEN=

# --- Observabilité ---
LANGFUSE_PUBLIC_KEY=pk-lf-dev-local
LANGFUSE_SECRET_KEY=sk-lf-dev-local
LANGFUSE_HOST=http://localhost:3001

# --- Clés API (facultatives en local, utiles pour tester le mode hybride) ---
GROQ_API_KEY=
TOGETHER_API_KEY=
MISTRAL_API_KEY=
FIREWORKS_API_KEY=

# --- Intégrations marketing tierces (comptes de test/sandbox) ---
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
FIGMA_ACCESS_TOKEN=
COMFYUI_BASE_URL=http://localhost:8188
COMFYUI_LORA_DIR=./data/comfyui/models/loras
SERPER_API_KEY=

# --- Sécurité & environnement ---
SECRET_KEY=dev-secret-key-not-for-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
DEBUG=True
ENVIRONMENT=development
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# --- Celery : broker/backend Redis local ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- AWS : non utilisé en local, stockage sur disque à la place ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-3
AWS_S3_BUCKET=

# --- Infrastructure Docker (services tiers, identifiants de dev uniquement) ---
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus
POSTGRES_DB=nexus_dev

MATOMO_DB_ROOT_PASSWORD=matomo
MATOMO_DB_NAME=matomo
MATOMO_DB_USER=matomo
MATOMO_DB_PASSWORD=matomo

MAUTIC_DB_ROOT_PASSWORD=mautic
MAUTIC_DB_NAME=mautic
MAUTIC_DB_USER=mautic
MAUTIC_DB_PASSWORD=mautic

N8N_ENCRYPTION_KEY=dev-encryption-key-not-for-production
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=admin

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

LANGFUSE_DATABASE_URL=postgresql://nexus:nexus@postgres:5432/langfuse
LANGFUSE_NEXTAUTH_SECRET=dev-nextauth-secret
LANGFUSE_SALT=dev-salt
