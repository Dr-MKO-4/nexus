# ============================================================
# NEXUS AI  Exemple de configuration
# Copier ce fichier en `.env` et renseigner les valeurs réelles.
# Ne jamais committer de vraies clés API ou secrets.
# ============================================================

# ------------------------------------------------------------
# LLM  mode de fonctionnement et modèles locaux
# ------------------------------------------------------------

# Stratégie d'inférence : "local" (modèles auto-hébergés uniquement),
# "api" (fournisseurs API uniquement), "hybrid" (arbitrage entre les deux)
LLM_MODE=hybrid

# Moteur d'inférence local : "ollama" ou "vllm"
LOCAL_INFERENCE_ENGINE=ollama

# Modèle local utilisé par défaut pour les tâches génériques
LOCAL_DEFAULT_MODEL=llama3.3:70b

# Modèle local léger pour les tâches à faible latence
LOCAL_FAST_MODEL=mistral:7b

# URL du serveur vLLM local (API compatible OpenAI)
VLLM_BASE_URL=http://localhost:8080

# URL du serveur Ollama local (tourne sur l'hôte, pas en conteneur)
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------
# LLM  fournisseurs API
# ------------------------------------------------------------

# Fournisseur API principal : "groq", "together" ou "mistral"
API_PRIMARY_PROVIDER=groq

# Fournisseur API de secours si le principal échoue : "together" ou "fireworks"
API_FALLBACK_PROVIDER=together

# Modèle par défaut chez le fournisseur API principal
API_DEFAULT_MODEL=llama-3.3-70b-versatile

# Modèle rapide/économique chez le fournisseur API principal
API_FAST_MODEL=llama-3.1-8b-instant

# ------------------------------------------------------------
# LLM  arbitrage du mode hybride
# ------------------------------------------------------------

# Budget quotidien maximal (USD) pour les appels API avant bascule vers le local
HYBRID_COST_DAILY_LIMIT_USD=50.0

# Seuil de charge GPU local (0.0 à 1.0) au-delà duquel on route vers l'API
HYBRID_GPU_LOAD_THRESHOLD=0.8

# Types de tâches toujours exécutées en local (données sensibles), séparées par des virgules
HYBRID_SENSITIVE_TASKS=["client_pii","financial_data"]

# ------------------------------------------------------------
# Base de données & stockage
# ------------------------------------------------------------

# Connexion PostgreSQL (base relationnelle principale)
DATABASE_URL=postgresql://nexus:nexus@localhost:5432/nexus

# Connexion Redis (cache, files d'attente Celery, état de session)
REDIS_URL=redis://localhost:6379/0

# Base vectorielle Qdrant (embeddings)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Service pytorch_models (classification, embeddings texte/image, scoring, anomalies)
PYTORCH_MODELS_URL=http://localhost:8001

# Service SearXNG (recherche de mots-clés, repli gratuit sans clé API)
SEARXNG_BASE_URL=http://localhost:8083
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=
MAUTIC_BASE_URL=http://localhost:8082
MAUTIC_CLIENT_ID=
MAUTIC_CLIENT_SECRET=
MATOMO_BASE_URL=http://localhost:8081
MATOMO_API_TOKEN=

# ------------------------------------------------------------
# Observabilité  LangFuse (tracing des agents et des appels LLM)
# ------------------------------------------------------------

LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxxxxxxxxxx
LANGFUSE_HOST=https://cloud.langfuse.com

# ------------------------------------------------------------
# Fournisseurs LLM  clés API (optionnelles selon LLM_MODE)
# ------------------------------------------------------------

GROQ_API_KEY=
TOGETHER_API_KEY=
MISTRAL_API_KEY=
FIREWORKS_API_KEY=

# ------------------------------------------------------------
# Intégrations marketing tierces (optionnelles)
# ------------------------------------------------------------

# API Google Ads
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# API Meta (Facebook/Instagram Ads)
META_APP_ID=
META_APP_SECRET=

# Figma (agent créatif)
FIGMA_ACCESS_TOKEN=

# ComfyUI (agent créatif  génération d'images, upscale)
COMFYUI_BASE_URL=http://localhost:8188
COMFYUI_LORA_DIR=./data/comfyui/models/loras

# Serper (recherche Google pour l'agent SEO)
SERPER_API_KEY=

# ------------------------------------------------------------
# Sécurité & environnement
# ------------------------------------------------------------

# Clé secrète applicative (signature JWT/sessions)  générer une valeur aléatoire forte
SECRET_KEY=change-me-in-every-environment

# Algorithme JWT et durées de validité des tokens (backend/api/auth.py, Prompt 7.1)
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Active le mode debug (logs verbeux, stack traces détaillées)
DEBUG=False

# Environnement courant : "development", "staging" ou "production"
ENVIRONMENT=development

# Origines autorisées par le middleware CORS (liste séparée par des virgules)
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# ------------------------------------------------------------
# Tâches asynchrones  Celery
# ------------------------------------------------------------

CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ------------------------------------------------------------
# AWS  stockage d'assets créatifs (optionnel)
# ------------------------------------------------------------

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-3
AWS_S3_BUCKET=

# ------------------------------------------------------------
# Infrastructure Docker  variables consommées par docker-compose
# (images tierces uniquement, non lues par l'application Python)
# ------------------------------------------------------------

# Postgres (doit rester cohérent avec DATABASE_URL ci-dessus)
POSTGRES_USER=nexus
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nexus

# Matomo (analytics web)  base MySQL dédiée
MATOMO_DB_ROOT_PASSWORD=change-me
MATOMO_DB_NAME=matomo
MATOMO_DB_USER=matomo
MATOMO_DB_PASSWORD=change-me

# Mautic (marketing automation)  base MySQL dédiée
MAUTIC_DB_ROOT_PASSWORD=change-me
MAUTIC_DB_NAME=mautic
MAUTIC_DB_USER=mautic
MAUTIC_DB_PASSWORD=change-me

# n8n (automatisation de workflows)
N8N_ENCRYPTION_KEY=change-me-32-chars-minimum
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me

# Grafana (dashboards de monitoring)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# LangFuse  secrets additionnels requis par le service web (au-delà des clés API déjà définies plus haut)
LANGFUSE_DATABASE_URL=postgresql://nexus:nexus@postgres:5432/langfuse
LANGFUSE_NEXTAUTH_SECRET=change-me
LANGFUSE_SALT=change-me
